# =============================================================================
# Oriel Power Ltd — environment variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# =============================================================================

# --- Site ---
# The public origin, with no trailing slash. Every canonical URL, the sitemap,
# robots.txt and all absolute links in emails and SMS are built from this.
# On production this MUST be https://orielpower.com — if it is wrong, Google
# indexes the wrong host (or, when it was unset, localhost).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (database, auth, storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Full access — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- M-Pesa Daraja (STK Push) — server-only, never in the client bundle ---
# Leave these blank in development to run the built-in simulator (see
# MPESA_SETUP.md). The simulator refuses to run when MPESA_ENVIRONMENT is
# production, so it can never touch real money.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=

# --- Staff access to the pay-on-delivery payment trigger ---
# Interim shared secret guarding POST /api/admin/orders/[n]/request-payment
# until Supabase Auth lands in Stage 8. The route returns 503 when this is
# unset, so the endpoint can never be left open by accident.
ADMIN_STAFF_KEY=

# --- Email (Resend) ---
# Order confirmations, receipts, invoices and every status update go through
# this. With it unset nothing is sent: each message is written to the email_log
# table with status 'skipped' and printed to the server console in full, so the
# copy can still be reviewed exactly as customers will receive it.
RESEND_API_KEY=
# The From address. Resend will only deliver from a domain VERIFIED IN THE
# RESEND DASHBOARD — add orielpower.com there and publish the DKIM/SPF records
# it gives you at Cloudoon. Until that is done every send fails with a 403,
# which is the correct failure: sending the company's receipts from somebody
# else's domain would be worse than not sending them.
EMAIL_FROM=Oriel Power Ltd <orders@orielpower.com>
# Where a customer's reply lands. Not a no-reply address, deliberately.
EMAIL_REPLY_TO=info@orielpower.com
# The shop's own copy of every new order.
ORDER_NOTIFICATION_EMAIL=orielpowerdm@gmail.com

# --- Tax ---
# Oriel Power Ltd's own KRA PIN. Printed in the header of every invoice and
# receipt. A tax invoice under the VAT Act must identify the supplier by PIN,
# and the documents are titled TAX INVOICE because the company is
# ETR-registered — so this is required, not optional.
# Left blank the line simply does not render: no token, no half-filled field,
# nothing a customer could mistake for a real PIN. See PLACEHOLDERS.md.
ORIEL_KRA_PIN=

# --- SMS (Africa's Talking) ---
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# --- Pricing ---
# Retail markup over dealer cost, as a percentage (e.g. 35 = +35%).
# Client must confirm before launch — see PLACEHOLDERS.md.
RETAIL_MARKUP_PERCENT=

# --- Analytics ---
# Google Analytics 4 measurement ID, in the form G-XXXXXXXXXX. Leave blank in
# development and on previews: the tag is not rendered at all when this is
# empty, so our own testing never pollutes the client's reports.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --- Google Search Console ---
# Only needed for the HTML-tag verification method, and only until the
# property is verified. Verifying the domain by DNS TXT record instead covers
# every subdomain and both http/https, and needs nothing here.
GOOGLE_SITE_VERIFICATION=

# Web push for the back-office app. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
